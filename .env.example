# Copy to .env for local use. Never commit the real .env file.

# Supabase connection string (Project Settings > Database > Connection string > URI).
# Leave empty to use a local file (data/db.json) while testing.
DATABASE_URL=

# Long random text used to sign login sessions. Required in production.
JWT_SECRET=

# The first administrator, created automatically when there are no users yet.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contact details shown on the site (defaults are already set).
CONTACT_EMAIL=Asotechservice@gmail.com
CONTACT_PHONE=0901 266 1712
CONTACT_WHATSAPP=2349012661712
